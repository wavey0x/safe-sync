{
  "name": "safe-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --serve",
    "sandbox": "bun scripts/build.ts && bun test/sandbox.ts",
    "sandbox:simple": "bun scripts/build.ts && bun test/sandbox.ts --simple",
    "sandbox:fast": "bun scripts/build.ts && bun test/sandbox.ts --fast",
    "test": "bun test"
  },
  "dependencies": {
    "lit-html": "3.3.1",
    "viem": "2.38.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "typescript": "5.9.3"
  }
}
