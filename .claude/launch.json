{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safe-sync",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "scripts/build.ts",
        "--serve"
      ],
      "port": 5173
    },
    {
      "name": "sandbox",
      "runtimeExecutable": "bun",
